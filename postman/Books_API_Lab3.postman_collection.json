{
  "info": {
    "_postman_id": "lab3-books-api-collection",
    "name": "Lab 3 — Books REST API",
    "description": "Complete Postman test collection covering success and failure cases for Lab 3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "GET /books — List all (default)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/books", "host": ["{{base_url}}"], "path": ["books"] }
      }
    },
    {
      "name": "GET /books — Search by title",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?search_q=harry",
          "host": ["{{base_url}}"], "path": ["books"],
          "query": [{ "key": "search_q", "value": "harry" }]
        }
      }
    },
    {
      "name": "GET /books — Sort by price DESC",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?order_by=price&order=DESC",
          "host": ["{{base_url}}"], "path": ["books"],
          "query": [
            { "key": "order_by", "value": "price" },
            { "key": "order",    "value": "DESC" }
          ]
        }
      }
    },
    {
      "name": "GET /books — Price range filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?min_price=10&max_price=50",
          "host": ["{{base_url}}"], "path": ["books"],
          "query": [
            { "key": "min_price", "value": "10" },
            { "key": "max_price", "value": "50" }
          ]
        }
      }
    },
    {
      "name": "GET /books — Pagination (limit + offset)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?limit=5&offset=0",
          "host": ["{{base_url}}"], "path": ["books"],
          "query": [
            { "key": "limit",  "value": "5" },
            { "key": "offset", "value": "0" }
          ]
        }
      }
    },
    {
      "name": "GET /books — Invalid order_by (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?order_by=password",
          "host": ["{{base_url}}"], "path": ["books"],
          "query": [{ "key": "order_by", "value": "password" }]
        }
      }
    },
    {
      "name": "GET /books/:id — Success (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/books/1", "host": ["{{base_url}}"], "path": ["books", "1"] }
      }
    },
    {
      "name": "GET /books/:id — Not Found (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/books/9999", "host": ["{{base_url}}"], "path": ["books", "9999"] }
      }
    },
    {
      "name": "POST /books — Create success (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 29.99,\n  \"year\": 2008,\n  \"genre\": \"Programming\"\n}"
        },
        "url": { "raw": "{{base_url}}/books", "host": ["{{base_url}}"], "path": ["books"] }
      }
    },
    {
      "name": "POST /books — Missing title (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author\": \"Some Author\",\n  \"price\": 15\n}"
        },
        "url": { "raw": "{{base_url}}/books", "host": ["{{base_url}}"], "path": ["books"] }
      }
    },
    {
      "name": "POST /books — Non-numeric price (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Some Book\",\n  \"author\": \"Some Author\",\n  \"price\": \"free\"\n}"
        },
        "url": { "raw": "{{base_url}}/books", "host": ["{{base_url}}"], "path": ["books"] }
      }
    },
    {
      "name": "POST /books — Missing all fields (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{base_url}}/books", "host": ["{{base_url}}"], "path": ["books"] }
      }
    },
    {
      "name": "PUT /books/:id — Update success (200)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code (Updated)\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 34.99\n}"
        },
        "url": { "raw": "{{base_url}}/books/1", "host": ["{{base_url}}"], "path": ["books", "1"] }
      }
    },
    {
      "name": "PUT /books/:id — Not Found (404)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ghost Book\",\n  \"author\": \"Nobody\",\n  \"price\": 1\n}"
        },
        "url": { "raw": "{{base_url}}/books/9999", "host": ["{{base_url}}"], "path": ["books", "9999"] }
      }
    },
    {
      "name": "DELETE /books/:id — Success (200)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{base_url}}/books/1", "host": ["{{base_url}}"], "path": ["books", "1"] }
      }
    },
    {
      "name": "DELETE /books/:id — Not Found (404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{base_url}}/books/9999", "host": ["{{base_url}}"], "path": ["books", "9999"] }
      }
    }
  ]
}
